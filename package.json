{
  "name": "salonflow",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "prisma skills sync || exit 0",
    "contract:emit": "prisma contract emit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "dotenv -e .env.test -- vitest run --coverage --config vitest.coverage.config.ts",
    "db:test:migrate": "dotenv -e .env.test -- prisma migrate deploy --config prisma-test.config.ts",
    "test:integration": "dotenv -e .env.test -- vitest run --config vitest.integration.config.ts",
    "test:e2e": "dotenv -e .env.test -- playwright test",
    "test:e2e:headed": "dotenv -e .env.test -- playwright test --headed",
    "test:e2e:ui": "dotenv -e .env.test -- playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "security:prod:check": "tsx scripts/check-production-env.ts",
    "db:prod:migrate": "prisma migrate deploy --config prisma7.config.ts",
    "db:prod:status": "prisma migrate status --config prisma7.config.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:prod:bootstrap": "tsx prisma/seed.ts",
    "db:prod:bootstrap:verify": "tsx scripts/verify-production-bootstrap.ts",
    "test:recette": "npm run db:test:migrate && npm run typecheck && npm run lint && npm run test:unit && npm run test:integration && npm run test:e2e && npm run build"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "lucide-react": "^0.468.0",
    "next": "16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
