generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EMPLOYEE
}

enum AppointmentStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CLOSED
  CANCELLED
}

enum AppointmentServiceStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum RoomType {
  HAMAM
  TREATMENT_ROOM
}

enum EmployeeUnavailabilityType {
  ABSENCE
  BREAK
  LEAVE
  UNAVAILABLE
}

enum PaymentMethod {
  CASH
}

enum PaymentStatus {
  PENDING
  PAID
}

model Salon {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  phone     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lifecycle SalonLifecycle @default(ACTIVE)
  timezone String @default("Africa/Casablanca")
  currency String @default("MAD") @db.VarChar(3)

  users             User[]
  employees         Employee[]
  clients           Client[]
  serviceCategories ServiceCategory[]
  services          Service[]
  rooms             Room[]
  appointments      Appointment[]
  activityLogs      ActivityLog[]
  subscription      SalonSubscription?
  platformIncidents PlatformIncident[]
  platformAuditLogs PlatformAuditLog[]
  subscriptionPayments SubscriptionPayment[]
  subscriptionDues SubscriptionDue[]

  @@map("salons")
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  salonId        String?  @db.Uuid
  email          String
  passwordHash   String
  firstName      String
  lastName       String?
  role           UserRole
  authVersion    Int      @default(0)
  canManageSalon Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  salon    Salon?    @relation(fields: [salonId], references: [id], onDelete: Restrict)
  employee Employee?

  createdAppointments             Appointment[]            @relation("AppointmentCreatedBy")
  cancelledAppointments           Appointment[]            @relation("AppointmentCancelledBy")
  createdParallelGroups           ParallelGroup[]          @relation("ParallelGroupCreatedBy")
  createdRoomUnavailabilities     RoomUnavailability[]     @relation("RoomUnavailabilityCreatedBy")
  createdEmployeeUnavailabilities EmployeeUnavailability[] @relation("EmployeeUnavailabilityCreatedBy")
  recordedPayments                Payment[]                @relation("PaymentRecordedBy")
  activityLogs                    ActivityLog[]
  platformAuditLogs                PlatformAuditLog[]

  @@unique([salonId, email])
  @@index([salonId])
  @@map("users")
}

model Employee {
  id        String   @id @default(uuid()) @db.Uuid
  salonId   String   @db.Uuid
  userId    String?  @unique @db.Uuid
  firstName String
  lastName  String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salon Salon @relation(fields: [salonId], references: [id])
  user  User? @relation(fields: [userId], references: [id])

  skills            EmployeeSkill[]
  unavailabilities  EmployeeUnavailability[]
  assignedServices  AppointmentService[]     @relation("AssignedEmployee")
  performedServices AppointmentService[]     @relation("PerformedByEmployee")

  @@index([salonId])
  @@map("employees")
}

model Client {
  id           String   @id @default(uuid()) @db.Uuid
  salonId      String   @db.Uuid
  name         String?
  phone        String
  internalNote String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  salon        Salon         @relation(fields: [salonId], references: [id])
  appointments Appointment[]

  @@unique([salonId, phone])
  @@index([salonId])
  @@map("clients")
}

model ServiceCategory {
  id           String   @id @default(uuid()) @db.Uuid
  salonId      String   @db.Uuid
  name         String
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  salon    Salon     @relation(fields: [salonId], references: [id])
  services Service[]

  @@unique([salonId, name])
  @@index([salonId])
  @@map("service_categories")
}

model Service {
  id                     String    @id @default(uuid()) @db.Uuid
  salonId                String    @db.Uuid
  categoryId             String    @db.Uuid
  name                   String
  defaultDurationMinutes Int?
  defaultPrice           Decimal   @db.Decimal(10, 2)
  isStartingPrice        Boolean   @default(false)
  requiredRoomType       RoomType?
  isActive               Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  salon    Salon           @relation(fields: [salonId], references: [id])
  category ServiceCategory @relation(fields: [categoryId], references: [id])

  employeeSkills      EmployeeSkill[]
  appointmentServices AppointmentService[]

  @@index([salonId])
  @@index([categoryId])
  @@map("services")
}

model EmployeeSkill {
  employeeId String   @db.Uuid
  serviceId  String   @db.Uuid
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])
  service  Service  @relation(fields: [serviceId], references: [id])

  @@id([employeeId, serviceId])
  @@index([serviceId])
  @@map("employee_skills")
}

model Appointment {
  id                       String            @id @default(uuid()) @db.Uuid
  salonId                  String            @db.Uuid
  clientId                 String            @db.Uuid
  scheduledStart           DateTime                   @default(now())
  estimatedDurationMinutes Int
  status                   AppointmentStatus @default(PLANNED)
  internalNote             String?
  createdByUserId          String            @db.Uuid
  cancelledByUserId        String?           @db.Uuid
  cancelledAt              DateTime?
  cancellationReason       String?           @db.VarChar(50)
  cancellationNote         String?           @db.VarChar(500)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  salon  Salon  @relation(fields: [salonId], references: [id])
  client Client @relation(fields: [clientId], references: [id])

  createdByUser   User  @relation("AppointmentCreatedBy", fields: [createdByUserId], references: [id])
  cancelledByUser User? @relation("AppointmentCancelledBy", fields: [cancelledByUserId], references: [id])

  services       AppointmentService[]
  parallelGroups ParallelGroup[]
  payment        Payment?

  @@index([salonId, scheduledStart])
  @@index([clientId])
  @@index([status])
  @@map("appointments")
}

model AppointmentService {
  id                       String                   @id @default(uuid()) @db.Uuid
  appointmentId            String                   @db.Uuid
  serviceId                String?                  @db.Uuid
  serviceNameSnapshot      String
  durationMinutes          Int
  scheduledStart           DateTime                   @default(now())
  price                    Decimal                  @db.Decimal(10, 2)
  basePriceSnapshot        Decimal?                 @db.Decimal(10, 2)
  priceAdjustmentReason    String?                  @db.VarChar(500)
  priceReviewedAt          DateTime?
  requiredRoomTypeSnapshot RoomType?
  status                   AppointmentServiceStatus @default(TODO)
  assignedEmployeeId       String?                  @db.Uuid
  performedByEmployeeId    String?                  @db.Uuid
  roomId                   String?                  @db.Uuid
  actualStartedAt          DateTime?
  actualFinishedAt         DateTime?
  employeeComment          String?                  @db.VarChar(2000)
  cancelledAt              DateTime?
  cancelledByUserId        String?                  @db.Uuid
  cancellationReason       String?                  @db.VarChar(500)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  service     Service?    @relation(fields: [serviceId], references: [id])

  assignedEmployee    Employee? @relation("AssignedEmployee", fields: [assignedEmployeeId], references: [id])
  performedByEmployee Employee? @relation("PerformedByEmployee", fields: [performedByEmployeeId], references: [id])

  room Room? @relation(fields: [roomId], references: [id])

  parallelGroupLinks ParallelGroupService[]

  @@index([appointmentId])
  @@index([scheduledStart])
  @@index([assignedEmployeeId])
  @@index([performedByEmployeeId])
  @@index([roomId])
  @@index([cancelledAt])
  @@map("appointment_services")
}

model ParallelGroup {
  id              String   @id @default(uuid()) @db.Uuid
  appointmentId   String   @db.Uuid
  createdByUserId String   @db.Uuid
  createdAt       DateTime @default(now())

  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  createdByUser User        @relation("ParallelGroupCreatedBy", fields: [createdByUserId], references: [id])

  services ParallelGroupService[]

  @@index([appointmentId])
  @@map("parallel_groups")
}

model ParallelGroupService {
  parallelGroupId      String @db.Uuid
  appointmentServiceId String @unique @db.Uuid

  parallelGroup      ParallelGroup      @relation(fields: [parallelGroupId], references: [id])
  appointmentService AppointmentService @relation(fields: [appointmentServiceId], references: [id])

  @@id([parallelGroupId, appointmentServiceId])
  @@map("parallel_group_services")
}

model Room {
  id        String   @id @default(uuid()) @db.Uuid
  salonId   String   @db.Uuid
  name      String
  type      RoomType
  capacity  Int      @default(1)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salon Salon @relation(fields: [salonId], references: [id])

  appointmentServices AppointmentService[]
  unavailabilities    RoomUnavailability[]

  @@unique([salonId, name])
  @@index([salonId, type])
  @@map("rooms")
}

model RoomUnavailability {
  id              String   @id @default(uuid()) @db.Uuid
  roomId          String   @db.Uuid
  startAt         DateTime
  endAt           DateTime
  reason          String?
  createdByUserId String   @db.Uuid
  createdAt       DateTime @default(now())

  room          Room @relation(fields: [roomId], references: [id])
  createdByUser User @relation("RoomUnavailabilityCreatedBy", fields: [createdByUserId], references: [id])

  @@index([roomId, startAt, endAt])
  @@map("room_unavailabilities")
}

model EmployeeUnavailability {
  id              String                     @id @default(uuid()) @db.Uuid
  employeeId      String                     @db.Uuid
  type            EmployeeUnavailabilityType
  startAt         DateTime
  endAt           DateTime
  note            String?
  createdByUserId String                     @db.Uuid
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  employee      Employee @relation(fields: [employeeId], references: [id])
  createdByUser User     @relation("EmployeeUnavailabilityCreatedBy", fields: [createdByUserId], references: [id])

  @@index([employeeId, startAt, endAt])
  @@map("employee_unavailabilities")
}

model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  appointmentId    String        @unique @db.Uuid
  amount           Decimal       @db.Decimal(10, 2)
  method           PaymentMethod @default(CASH)
  status           PaymentStatus @default(PENDING)
  paidAt           DateTime?
  recordedByUserId String?       @db.Uuid
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  appointment    Appointment @relation(fields: [appointmentId], references: [id])
  recordedByUser User?       @relation("PaymentRecordedBy", fields: [recordedByUserId], references: [id])

  @@map("payments")
}

model ActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  salonId    String   @db.Uuid
  userId     String   @db.Uuid
  action     String
  entityType String
  entityId   String   @db.Uuid
  metadata   Json?
  createdAt  DateTime @default(now())

  salon Salon @relation(fields: [salonId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@index([salonId, createdAt])
  @@index([entityType, entityId])
  @@map("activity_logs")
}


enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum IncidentPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

model SalonSubscription {
  id          String             @id @default(uuid()) @db.Uuid
  salonId     String             @unique @db.Uuid
  planName    String             @default("Pilote")
  status      SubscriptionStatus @default(TRIAL)
  monthlyPrice Decimal           @default(0) @db.Decimal(10, 2)
  currency    String             @default("MAD") @db.VarChar(3)
  periodEnd   DateTime?
  note        String?            @db.VarChar(1000)
  updatedAt   DateTime           @updatedAt
  salon       Salon              @relation(fields: [salonId], references: [id], onDelete: Restrict)

  @@map("salon_subscriptions")
}

model PlatformIncident {
  id          String           @id @default(uuid()) @db.Uuid
  salonId     String?          @db.Uuid
  title       String           @db.VarChar(150)
  description String           @db.VarChar(3000)
  priority    IncidentPriority @default(NORMAL)
  status      IncidentStatus   @default(OPEN)
  resolution  String?          @db.VarChar(3000)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  reportedById String? @db.Uuid
  resolvedAt  DateTime?
  salon       Salon?           @relation(fields: [salonId], references: [id], onDelete: Restrict)

  messages PlatformIncidentMessage[]

  @@index([status, createdAt])
  @@index([salonId])
  @@map("platform_incidents")
}

model PlatformAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String   @db.Uuid
  salonId     String?  @db.Uuid
  action      String
  entityId    String   @db.Uuid
  details     Json
  createdAt   DateTime @default(now())
  actor       User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  salon       Salon?   @relation(fields: [salonId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([salonId, createdAt])
  @@map("platform_audit_logs")
}


enum SalonLifecycle {
  PREPARING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model SubscriptionPayment {
  due SubscriptionDue?
  id String @id @default(uuid()) @db.Uuid
  salonId String @db.Uuid
  amount Decimal @db.Decimal(10, 2)
  currency String @db.VarChar(3)
  paidAt DateTime
  periodStart DateTime
  periodEnd DateTime
  method String @db.VarChar(40)
  reference String? @db.VarChar(150)
  recordedById String @db.Uuid
  voidedAt DateTime?
  voidReason String? @db.VarChar(500)
  createdAt DateTime @default(now())
  salon Salon @relation(fields: [salonId], references: [id], onDelete: Restrict)
  @@index([salonId, paidAt])
  @@map("subscription_payments")
}

model PlatformIncidentMessage {
  id String @id @default(uuid()) @db.Uuid
  incidentId String @db.Uuid
  authorId String @db.Uuid
  internal Boolean @default(false)
  body String @db.VarChar(3000)
  createdAt DateTime @default(now())
  incident PlatformIncident @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  @@index([incidentId, createdAt])
  @@map("platform_incident_messages")
}

model LoginThrottle {
  key String @id
  attempts Int @default(1)
  expiresAt DateTime
  @@index([expiresAt])
  @@map("login_throttles")
}


model SubscriptionDue {
  id String @id @default(uuid()) @db.Uuid
  salonId String @db.Uuid
  title String @db.VarChar(150)
  dueAt DateTime
  amount Decimal @db.Decimal(10, 2)
  currency String @db.VarChar(3)
  paymentId String? @unique @db.Uuid
  processedAt DateTime?
  cancelledAt DateTime?
  note String? @db.VarChar(500)
  createdAt DateTime @default(now())
  salon Salon @relation(fields: [salonId], references: [id], onDelete: Restrict)
  payment SubscriptionPayment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  @@unique([salonId, dueAt, title])
  @@index([dueAt, salonId])
  @@map("subscription_dues")
}
